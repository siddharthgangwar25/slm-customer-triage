FROM python:3.11.16-slim@sha256:e41613d42d4891e4930f79523f93f81bbc7632584ec65e36ab055f41a800b41e
WORKDIR /app
RUN pip install --no-cache-dir uv==0.12.19
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable
COPY configs ./configs
COPY prompts ./prompts
RUN useradd --uid 10001 --create-home triage
USER 10001
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK --interval=30s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready')"
ENTRYPOINT ["triage", "serve", "--host", "0.0.0.0"]
CMD ["--bundle", "artifacts/baseline-c1-v1", "--policy", "reports/baseline-c1-v1-policy/policy.json"]
